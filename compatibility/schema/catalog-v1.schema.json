{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coconiiruzo/acpxx/compatibility/schema/catalog-v1.schema.json",
  "title": "agentmux Provider Compatibility Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "sequence", "generated_at", "expires_at", "entries", "channels"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/channel" }
    }
  },
  "$defs": {
    "provider": { "enum": ["codex", "claude", "grok", "cursor"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_version", "normalized_version", "components"],
      "properties": {
        "display_version": { "type": "string", "minLength": 1 },
        "normalized_version": { "type": "string", "minLength": 1 },
        "components": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "algorithm", "digest"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_version", "tested_at", "evidence_digest"],
      "properties": {
        "suite_version": { "type": "integer", "minimum": 1 },
        "tested_at": { "type": "string", "format": "date-time" },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "provider", "target", "driver_id", "driver_revision", "agentmux_requirement", "protocol", "identity", "artifacts", "state", "not_after", "qualification"],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "provider": { "$ref": "#/$defs/provider" },
        "target": { "type": "string", "minLength": 1 },
        "driver_id": { "type": "string", "minLength": 1 },
        "driver_revision": { "type": "integer", "minimum": 1 },
        "agentmux_requirement": { "type": "string", "minLength": 1 },
        "protocol": { "const": "v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "state": { "enum": ["verified", "deprecated", "blocked"] },
        "not_after": { "type": ["string", "null"], "format": "date-time" },
        "qualification": { "$ref": "#/$defs/qualification" }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "target", "name", "entry_id"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "target": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "entry_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
